# Core
DEBUG=True
SECRET_KEY=change-me-to-a-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=ajna_health_lens
DB_USER=ajna_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@ajnahealthlens.example

# Journal
JOURNAL_NAME=Ajna Health Lens
JOURNAL_TAGLINE=Illuminating Health Research
JOURNAL_ISSN=0000-0000
JOURNAL_PUBLISHER=Ajna Health Lens Publishing
JOURNAL_CONTACT_EMAIL=editors@ajnahealthlens.example
