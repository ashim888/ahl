# Core
# DEBUG=True only on your own machine — never on a server (debug error pages
# expose code and settings). Left out or False, debug is off.
DEBUG=False
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=ajna_health_lens
DB_USER=ajna_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# File storage — omit both for local defaults (/media/, BASE_DIR/media).
# In production, set both to match the nginx location block serving /media/
# directly — see ARCHITECTURE.md §9.2. MEDIA_URL can also be a full CDN
# domain (e.g. https://cdn.example.com/media/) if media moves behind one
# later — no code change needed either way.
# MEDIA_URL=/media/
# MEDIA_ROOT=/var/www/ajna/media
# Article PDFs and CVs — must NOT be served by nginx/Apache (Django checks
# access on /protected-media/). Keep it outside the public media folder.
# PRIVATE_MEDIA_ROOT=/var/www/ajna/private_media

# Email — console backend just prints emails to the terminal, fine for dev.
# For real sending (newsletter, verification, comment confirmation, etc.),
# switch EMAIL_BACKEND to the smtp one and fill in real values below — any
# SMTP-based ESP works here (a generic relay, or the SMTP interface most
# providers offer alongside their native API); no provider-specific SDK is
# used. See ARCHITECTURE.md §4.10 for how the newsletter's bulk send reuses
# one connection across the whole recipient list rather than reconnecting
# per email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Port 587 -> EMAIL_USE_TLS=True, EMAIL_USE_SSL=False (STARTTLS).
# Port 465 -> EMAIL_USE_TLS=False, EMAIL_USE_SSL=True (implicit SSL; typical cPanel).
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Seconds before giving up on an unreachable SMTP server (otherwise a
# request that sends mail, e.g. a comment post, can hang).
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=noreply@ajnahealthlens.com

# Public base URL of the site, no trailing slash. REQUIRED in production:
# every link in outgoing email (confirm comment, confirm/unsubscribe
# newsletter, "read the discussion") is built from it, and the comments
# package's Site domain is synced from it on every `migrate`. Left at the
# localhost default, emails still send but every link in them is dead —
# `manage.py check --deploy` (deploy.sh step 7) flags this as ajna.E001.
SITE_BASE_URL=http://ajnahealthlens.com

# Error reporting — comma-separated list of addresses to email on an
# unhandled 500 in production (Django's AdminEmailHandler, see
# ajna_health_lens/settings.py LOGGING). Blank means nobody gets notified —
# that's the safe default for dev/CI, but set this before a real launch.
ADMIN_EMAILS=
SERVER_EMAIL=noreply@ajnahealthlens.com

# Journal
JOURNAL_NAME=Ajna Health Lens
JOURNAL_TAGLINE=Illuminating Health Research
JOURNAL_ISSN=0000-0000
JOURNAL_PUBLISHER=Ajna Health Lens Publishing
JOURNAL_CONTACT_EMAIL=editors@ajnahealthlens.com


TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Backups (backup.sh) — optional overrides, sensible defaults if unset.
# BACKUP_DIR=backups
# BACKUP_RETENTION_DAYS=14

SITE_BASE_URL=http://localhost.com

# Payment gateway — "stub" (no real money, default) or "fonepay".
# Fonepay credentials come from Fonepay; the private key is Base64 PKCS#8
# without the BEGIN/END lines. Never commit real values.
PAYMENT_GATEWAY=stub
FONEPAY_API_URL=https://dev-external-gateway-new.fonepay.com/merchantThirdparty/api/merchant/third-party/v2
FONEPAY_USERNAME=
FONEPAY_PASSWORD=
FONEPAY_PRIVATE_KEY=
FONEPAY_TERMINAL_ID=
FONEPAY_PAYMENT_TIMEOUT_MINUTES=15

# Google Analytics measurement ID — loaded only after a reader accepts
# analytics cookies. Leave empty to switch analytics off.
GOOGLE_ANALYTICS_ID=

# Two-step sign-in for staff — leave True on any real server.
STAFF_TWO_FACTOR_REQUIRED=True

# Error tracking: paste the project's DSN from sentry.io (free plan is fine).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Nightly encrypted database backup by email. Use a long random password and
# store it in a password manager, not only here — without it a backup can't
# be restored. Gmail and most providers cap attachments around 20-25 MB.
BACKUP_EMAIL=
BACKUP_ENCRYPTION_PASSWORD=
BACKUP_EMAIL_MAX_MB=20

# Billing — prices are VAT-exclusive; VAT_RATE percent is added at checkout.
# The business details below are printed on every receipt.
VAT_RATE=13
BUSINESS_LEGAL_NAME=
BUSINESS_PAN=
BUSINESS_ADDRESS=
RECEIPT_PREFIX=AHL-
# Dates on invoices: both (AD and BS), ad, or bs.
INVOICE_DATE_DISPLAY=both
# Readers may cancel a subscription for a full refund within this many days of paying.
SUBSCRIPTION_CANCEL_DAYS=3
# Content-Security-Policy: True only reports violations (to the log) instead of blocking.
CSP_REPORT_ONLY=False
