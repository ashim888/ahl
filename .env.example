# Core
DEBUG=True
SECRET_KEY=change-me-to-a-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=ajna_health_lens
DB_USER=ajna_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# File storage — omit both for local defaults (/media/, BASE_DIR/media).
# In production, set both to match the nginx location block serving /media/
# directly — see ARCHITECTURE.md §9.2. MEDIA_URL can also be a full CDN
# domain (e.g. https://cdn.example.com/media/) if media moves behind one
# later — no code change needed either way.
# MEDIA_URL=/media/
# MEDIA_ROOT=/var/www/ajna/media

# Email — console backend just prints emails to the terminal, fine for dev.
# For real sending (newsletter, verification, comment confirmation, etc.),
# switch EMAIL_BACKEND to the smtp one and fill in real values below — any
# SMTP-based ESP works here (a generic relay, or the SMTP interface most
# providers offer alongside their native API); no provider-specific SDK is
# used. See ARCHITECTURE.md §4.10 for how the newsletter's bulk send reuses
# one connection across the whole recipient list rather than reconnecting
# per email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@ajnahealthlens.com

# Journal
JOURNAL_NAME=Ajna Health Lens
JOURNAL_TAGLINE=Illuminating Health Research
JOURNAL_ISSN=0000-0231
JOURNAL_PUBLISHER=Ajna Health Lens Publishing
JOURNAL_CONTACT_EMAIL=editors@ajnahealthlens.com


TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
